{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-bootstrap.sh\" --quiet 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-gate.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(gh pr new *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-gate.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(gh pr ready *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-gate.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-gate.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(git * push *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-gate.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-gate.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(git * commit *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-gate.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create|update)_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.githooks/pr-ready-gate.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
