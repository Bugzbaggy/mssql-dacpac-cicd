# EditorConfig — https://editorconfig.org
# Formatting standards for AppDb_Analytics (see CLAUDE.md "Code Formatting Standards")

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

# SQL source objects — tabs, trailing whitespace trimmed (project preference)
[*.sql]
indent_style = tab

# Markdown — keep trailing whitespace (two trailing spaces = hard line break)
[*.md]
trim_trailing_whitespace = false

# YAML (CI workflows, configs) — spaces, not tabs
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# PowerShell (CI/CD scripts) — 4-space indent is the PS convention
[*.ps1]
indent_style = space
indent_size = 4

# JSON config
[*.json]
indent_style = space
indent_size = 2
